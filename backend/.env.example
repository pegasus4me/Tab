PORT=8787
OURS_NETWORK=monad-testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
DYNAMIC_ENVIRONMENT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OURS_FACTORY_ADDRESS=
COUNT_ME_IN_FACTORY_ADDRESS=
COUNT_ME_IN_RELAYER_PRIVATE_KEY=
E2E_GUEST_PRIVATE_KEY=
ENVIO_INDEXER_ENDPOINT=http://localhost:8080/v1/graphql
SUPABASE_DATABASE_URL=
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_API_KEY=
PWA_ORIGIN=http://localhost:3000

# PIN persistence — set the project URL and its server-only service_role key.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the PWA or commit it to source control.
SUPABASE_URL=https://cfsrsvvmwataxnnurvld.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# MoonPay — production only. Never expose these values to the PWA or commit .env.
# Leave blank on Monad testnet: test funding uses a faucet/manual test USDC.
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_API_KEY=
MOONPAY_WEBHOOK_API_KEY=
# Optional: only set this for a MoonPay sandbox/staging environment.
MOONPAY_API_BASE_URL=https://api.moonpay.com

# DYNAMIC_ENVIRONMENT_ID is public configuration shared with the PWA. Dynamic
# JWTs are verified against its JWKS endpoint; no wallet private key lives here.

# Family/plan persistence: one API process with a persistent disk.
# Defaults to backend/.data; keep private and back up this directory.
OURS_DATA_DIR=
# Dedicated fee-paying schedule runner, never a family/parent private key.
# Run npm run schedules:run periodically in the deployment environment.
OURS_RELAYER_PRIVATE_KEY=

# Development-only activation fee coverage, capped at 1 MON per account / 5 MON total.
# Ignored on mainnet. Prefer a dedicated sponsor key in deployed environments.
OURS_TESTNET_SPONSOR_PRIVATE_KEY=
# Local alternative: path to a private env file containing DEPLOYER_PRIVATE_KEY.
OURS_TESTNET_SPONSOR_ENV_FILE=

# Family invitation emails. The sender must use a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ours <invites@example.com>
OURS_APP_URL=http://localhost:5173

# Meta WhatsApp Cloud API. Create and approve the named invitation template in
# Meta before enabling outbound delivery. These values are server-only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v24.0
